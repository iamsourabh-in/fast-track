# Selected LLM Provider: 'ollama' | 'openai' | 'gemini'
LLM_PROVIDER=ollama

# Provider Credentials & Settings
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Application Execution Settings
# Mode: 'copilot' | 'autonomous' | 'stealth' | 'swipe'
APPLY_MODE=autonomous
MAX_DAILY_APPLICATIONS=250
HEADLESS=false
PORT=3000
